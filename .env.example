# Docker Compose PostgreSQL credentials.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="report_automation"

# Matches the Docker Compose service exposed on localhost:5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/report_automation"

# true: in-memory sample data, no database required
# false: Prisma + PostgreSQL persistence
DEMO_MODE="false"

# Optional first-step app authentication.
# When AUTH_SECRET and AUTH_PASSWORD are both set, all pages and API routes
# except /login and /api/health require an authenticated session cookie.
AUTH_USERNAME="admin"
AUTH_PASSWORD="change-me"
AUTH_SECRET="replace-with-a-long-random-secret"

AI_PROVIDER="gemini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-5.4-mini"

OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="llama3.1"

OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
